# ---- Accounts & sessions ----
# Shared by the API (signs sessions) and the web app (verifies them). Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-with-a-long-random-secret
# First admin account, created by `python -m app.seed`. Change the password after first sign-in.
ADMIN_EMAIL=admin@gyt.com
ADMIN_PASSWORD=change-me-before-deploy
# Service token for the simulator, schedulers and CI (not for people). Leave empty to disable.
ADMIN_TOKEN=replace-with-another-long-random-secret
# Encrypts bank account numbers at rest: 64 hex characters.
#   python -c "import secrets; print(secrets.token_hex(32))"
BANK_DATA_KEY=replace-with-64-hex-characters

# ---- Chain (local Anvil defaults; account #0 is a public test key, never use it on a real network) ----
DEPLOYER_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
ANCHOR_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
# Printed by the deploy step (these are the deterministic Anvil addresses)
PROOF_REGISTRY_ADDRESS=0x9fE46736679d2D9a65F0992F2272dE9f3c7fa6e0
YACHT_TWIN_ADDRESS=0xe7f1725E7734CE288F8367e1Bb143E90bb3F0512
ARRIVAL_ESCROW_ADDRESS=0xDc64a140Aa3E981100a9becA4E685f962f0cF6C9
IDENTITY_REGISTRY_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3
ANCHOR_INTERVAL_SECONDS=600

# ---- Live data feeds (optional; adapters do nothing without them) ----
AISHUB_USERNAME=
GFW_API_TOKEN=                      # Global Fishing Watch, for SAR detections
OSIRIS_ENDPOINT=                    # CNR-ISTI OSIRIS deployment under a research partnership
KYC_PROVIDER_KEY=

# ---- Live maps (free providers) ----
AISSTREAM_API_KEY=                  # free key at https://aisstream.io (worldwide, server-side only)
DIGITRAFFIC_ENABLED=true            # Fintraffic open AIS, no key, CC BY 4.0 (Finnish waters)
DIGITRAFFIC_USER=GYT/0.3            # sent as the Digitraffic-User header, as Fintraffic asks
NEXT_PUBLIC_MAP_STYLE=https://tiles.openfreemap.org/styles/positron
NEXT_PUBLIC_MAP_STYLE_DARK=https://tiles.openfreemap.org/styles/dark
NEXT_PUBLIC_HERO_VIDEO_URL=         # optional: swap in a licensed clip; default /media/hero-yacht.mp4

# ---- Uploads ----
MEDIA_DIR=media                     # where owner photos are stored (mount a volume in production)

# Settings for docker-compose.hostinger.yml. Set these in Hostinger Docker Manager (Environment variables),
# or copy this file to .env next to the compose file on the VPS. Never commit the real values.
#
# Generate secrets on the VPS with:   openssl rand -hex 32

# Your domain. Point its A record (and www, if used) at the VPS's IP address first.
DOMAIN=app.example.com

# The database on the VPS (PostgreSQL + PostGIS). Any long random string.
POSTGRES_PASSWORD=

# Signs sign-in sessions. At least 32 characters (openssl rand -hex 32).
JWT_SECRET=

# The primary admin: every right, can never be deleted. Use a strong password, not the demo one.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Encrypts stored bank details. Exactly 64 hex characters (openssl rand -hex 32). Keep a copy somewhere
# safe: without it, saved bank details can't be read back.
BANK_DATA_KEY=

# Optional
ADMIN_TOKEN=
ANTHROPIC_API_KEY=
AISSTREAM_API_KEY=
DIGITRAFFIC_ENABLED=false
AUTOPILOT_INTERVAL_SECONDS=300

# Optional: a real chain for proofs and tokens (leave empty to run without on-chain anchoring)
CHAIN_RPC=
ANCHOR_PRIVATE_KEY=
PROOF_REGISTRY_ADDRESS=
YACHT_TWIN_ADDRESS=
ARRIVAL_ESCROW_ADDRESS=
IDENTITY_REGISTRY_ADDRESS=
ANCHOR_INTERVAL_SECONDS=0
